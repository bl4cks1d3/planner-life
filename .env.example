# Planner Core
CORE_PORT=4000
DB_PATH=./data/planner.db

# Agent runtime -- Personal Agent
AGENT_PORT=4100
CORE_API_URL=http://localhost:4000

# Qual provider de IA usar: groq | gemini | anthropic
# Deixe em branco para autodetectar pela primeira chave preenchida abaixo
# (ordem: Groq -> Gemini -> Anthropic). Groq e Gemini tem free tier.
AGENT_PROVIDER=

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic / Claude (pago) - opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# P2P node
P2P_TCP_PORT=15000
P2P_NODE_NAME=pc-principal
